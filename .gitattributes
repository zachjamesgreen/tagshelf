# Every file is checked out exactly as it was committed, with LF line endings,
# whatever core.autocrlf says: gofmt, the tests' golden files and the audio
# fixtures all depend on the bytes.
* -text

# Audio fixtures must never have their line endings touched.
testdata/audio/*.mp3 binary
testdata/audio/*.flac binary
testdata/audio/*.ogg binary
testdata/audio/*.m4a binary
testdata/audio/*.m4b binary
testdata/audio/*.wav binary
testdata/audio/*.wma binary
testdata/audio/*.aac binary
testdata/audio/*.ape binary
testdata/audio/*.mpc binary
internal/tagwrite/testdata/* binary

# The TUI's golden screens are compared byte for byte: LF, whatever
# core.autocrlf says.
internal/tui/testdata/*.golden text eol=lf

# The fingerprint module and its test audio are bytes, not text.
internal/fingerprint/fp.wasm binary
internal/fingerprint/testdata/tune* binary
